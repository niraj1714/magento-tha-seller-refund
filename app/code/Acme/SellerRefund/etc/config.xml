<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <acme_seller_refund>
            <general>
                <window_days>7</window_days>
            </general>
            <erp>
                <base_url>http://erp-refund-stub:8081</base_url>
                <connect_timeout>2</connect_timeout>
                <timeout>3</timeout>
                <max_attempts>8</max_attempts>
                <backoff_base_seconds>5</backoff_base_seconds>
                <backoff_cap_seconds>300</backoff_cap_seconds>
            </erp>
            <email>
                <confirmation_template>acme_seller_refund_confirmed_template</confirmation_template>
                <confirmation_identity>general</confirmation_identity>
            </email>
        </acme_seller_refund>
    </default>
</config>
